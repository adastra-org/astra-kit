{
  "name": "astra-kit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "lab"
  ],
  "scripts": {
    "tokens": "bun packages/tokens/scripts/tokens.ts",
    "lab": "vite lab",
    "lab:build": "vite build lab",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test --pass-with-no-tests packages scripts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "release": "bun scripts/publish.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.70.0",
    "motion": "^14.11.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
