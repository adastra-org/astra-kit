{
  "name": "@adastrarp/tokens",
  "version": "0.1.0",
  "description": "Ad Astra design tokens for Tailwind v4: Void (dark, default) and Dawn (light) themes, roles, type utilities, self-hosted fonts and the opt-in glass skin.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adastra-org/astra-kit.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "theme.css",
    "tokens.css",
    "fonts.css",
    "glass.css",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./theme.css",
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./glass.css": "./glass.css"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/averia-serif-libre": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.0"
  }
}
